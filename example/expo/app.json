{
  "expo": {
    "name": "Pose Detection",
    "slug": "pose-detection-example",
    "version": "0.0.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "android": {
      "package": "com.posedetection.example",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1220"
      }
    },
    "ios": {
      "bundleIdentifier": "com.posedetection.example",
      "supportsTablet": true
    },
    "plugins": [
      [
        "react-native-pose-detection",
        {
          "model": "full",
          "cameraPermissionText": "This example uses the camera to detect your pose on device."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "This example runs pose detection on an image or video you pick."
        }
      ]
    ],
    "updates": {
      "enabled": false
    },
    "icon": "./assets/icon.png"
  }
}
